        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/ServiceAccount"/>
        <rdfs:comment>Links a Policy to the ServiceAccount identity it is binding.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/bindsToGateway -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/bindsToGateway">
