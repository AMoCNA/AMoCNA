        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/ServiceAccount"/>
        <rdfs:comment>Links an ExecutionUnit to the ServiceAccount identity it uses.</rdfs:comment>
    </owl:ObjectProperty>


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/managesProxy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/managesProxy">
