    </owl:Class>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/Log -->

    <owl:Class rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/Log">
