        <rdfs:range rdf:resource="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/Gateway"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/communicatesWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/szymo/ontologies/2026/2/CNEEOnt/communicatesWith">
