${SPARQL_PREFIXES}
SELECT DISTINCT ?rootResource ?rootResourceName ?intent
WHERE {
  # 1. Map anomaly type to remediation intent (Optimized)
  ?anomalyType rdfs:subClassOf* ?restriction .
  ?restriction a owl:Restriction ;
               owl:onProperty ${PREFIX::BRIDGE_PREFIX}:isResolvedByIntent ;
               owl:someValuesFrom ?intent .

  # 2. Find topology-linked resource that HAS this anomaly type
  ${IRI::startResource} (${PREFIX::RESOURCES_PREFIX}:dependsOn|${PREFIX::RESOURCES_PREFIX}:usesStorage|${PREFIX::RESOURCES_PREFIX}:isHostedOn|${PREFIX::RESOURCES_PREFIX}:isRealizedBy)* ?anomalyResource .

  ?anomalyResource ${PREFIX::RESOURCES_PREFIX}:hasState ?state .
  ?state a ?anomalyType .
  FILTER (!isBlank(?anomalyType))

  # 3. Escalate to the remediation target (e.g. from Pod to its parent Deployment)
  # If the resource is part of something else, follow the chain UP to find the highest parent.
  ?anomalyResource (${PREFIX::RESOURCES_PREFIX}:isPartOf)* ?rootResource .
  FILTER NOT EXISTS { ?rootResource ${PREFIX::RESOURCES_PREFIX}:isPartOf ?higher . }

  ?rootResource ${PREFIX::RESOURCES_PREFIX}:resourceName ?rootResourceName .

  # 4. Filter out resources that already have an active action
  FILTER NOT EXISTS {
    ?action ${PREFIX::ACTIONS_PREFIX}:targetsEntity ?rootResource .
    ?action ${PREFIX::ACTIONS_PREFIX}:hasCurrentState ?currentState .
    FILTER(?currentState IN (${PREFIX::ACTIONS_PREFIX}:${INDIVIDUAL::STATE_INITIAL}, ${PREFIX::ACTIONS_PREFIX}:${INDIVIDUAL::STATE_PLANNED}, ${PREFIX::ACTIONS_PREFIX}:${INDIVIDUAL::STATE_VALIDATED}, ${PREFIX::ACTIONS_PREFIX}:${INDIVIDUAL::STATE_INPROGRESS}, ${PREFIX::ACTIONS_PREFIX}:${INDIVIDUAL::STATE_COMPENSATING}))
  }
}

